# PostgreSQL connection string (Neon / Supabase / Vercel Postgres).
# The schema is upgraded automatically on the first request.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# The ONE administrator. There is no public sign-up or student login.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME

# Cookie-signing secret; generate a fresh value with: openssl rand -base64 48
ADMIN_SESSION_SECRET=CHANGE_ME
