# PostgreSQL connection string (Vercel Postgres / Neon / Supabase …).
# Tables are created automatically on the first request — no migration step needed.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# REQUIRED for the admin area: your own email. ONLY the emails listed here
# (comma-separated) get admin rights — nobody else, not even the first sign-up.
ADMIN_EMAILS=you@example.com
